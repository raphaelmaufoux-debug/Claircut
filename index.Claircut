<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f6f2">
  <title>Claircut — De longues vidéos, de bons clips</title>
  <style>
    :root{--ink:#17231f;--muted:#68736d;--paper:#f7f6f2;--white:#fff;--green:#c9f36a;--line:#e5e6df;--dark:#17231f;--coral:#ff876d;--serif:Georgia,'Times New Roman',serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}button,input{font:inherit}button{cursor:pointer}.wrap{width:min(1160px,calc(100% - 48px));margin:auto}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;gap:10px;align-items:center;font-weight:800;font-size:21px;letter-spacing:-.8px}.logo{width:31px;height:31px;border-radius:10px;background:var(--green);display:grid;place-items:center;font-size:18px}.navlinks{display:flex;gap:30px;align-items:center;color:#48534e;font-size:14px}.navlinks a:hover{color:#000}.navright{display:flex;gap:18px;align-items:center;font-size:14px}.btn{border:0;border-radius:99px;padding:13px 19px;font-weight:700;display:inline-flex;align-items:center;gap:8px;transition:.2s}.btn:hover{transform:translateY(-2px)}.btn-dark{background:var(--dark);color:white}.btn-lime{background:var(--green);color:var(--ink)}.btn-light{background:white;border:1px solid var(--line)}.hero{display:grid;grid-template-columns:1.02fr .98fr;gap:60px;align-items:center;padding:76px 0 86px}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid #dce0d4;padding:7px 11px;border-radius:99px;color:#4f5e53;font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}.dot{width:7px;height:7px;background:#8abe39;border-radius:50%}h1{font:500 clamp(48px,6vw,76px)/.99 var(--serif);letter-spacing:-3.5px;margin:24px 0 20px;max-width:620px}h1 em{font-weight:400;color:#6e8a42}.lead{font-size:18px;color:var(--muted);max-width:510px;margin:0 0 28px}.actions{display:flex;gap:11px;align-items:center;flex-wrap:wrap}.micro{font-size:12px;color:#737e77;margin-top:15px}.stage{position:relative;min-height:460px;background:#e8e9dd;border-radius:28px;overflow:hidden;padding:25px;display:flex;align-items:center;justify-content:center}.stage:before{content:"";position:absolute;width:370px;height:370px;background:#d0ecaa;border-radius:50%;right:-90px;top:-90px}.video{position:relative;width:280px;height:355px;border:8px solid white;border-radius:25px;overflow:hidden;box-shadow:0 24px 70px #28382e33;background:linear-gradient(145deg,#7e9582,#c1a284 46%,#574c43);transform:rotate(3deg)}.video:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#101a16dc,transparent 60%)}.person{position:absolute;width:105px;height:175px;left:85px;top:73px;background:linear-gradient(90deg,#1f2926,#39443d);border-radius:48% 48% 20% 20%}.person:before{content:"";position:absolute;width:74px;height:84px;border-radius:50%;background:#bd8e6e;top:-40px;left:14px}.person:after{content:"";position:absolute;width:36px;height:35px;border-radius:45%;background:#30251f;top:-46px;left:30px}.sub{position:absolute;bottom:45px;left:18px;right:18px;text-align:center;color:white;font-weight:900;font-size:21px;line-height:1.08;text-shadow:0 2px 3px #111}.sub b{color:var(--green)}.play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#ffffffdf;border-radius:50%;width:46px;height:46px;display:grid;place-items:center;padding-left:3px}.clip-label{position:absolute;z-index:1;background:white;border-radius:14px;padding:12px 15px;box-shadow:0 12px 32px #2634281c;font-size:12px}.clip-label strong{display:block;font-size:14px}.label-top{top:72px;left:20px}.label-bottom{bottom:42px;right:15px}.wave{font-size:13px;letter-spacing:2px;color:#7f9c5b;margin-top:4px}.bar{position:absolute;bottom:0;left:0;height:5px;width:68%;background:var(--green)}
    .trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;display:flex;justify-content:space-between;align-items:center;gap:20px;color:#68736d;font-size:13px}.trust strong{color:var(--ink);font-size:14px}.trust-items{display:flex;gap:27px;align-items:center}.trust-items span{display:flex;gap:8px;align-items:center}.tick{color:#6f913b;font-weight:900}.section{padding:100px 0}.section-head{max-width:650px;margin-bottom:42px}.kicker{color:#748d4a;text-transform:uppercase;font-size:12px;letter-spacing:.12em;font-weight:800}h2{font:500 clamp(37px,4.5vw,54px)/1.04 var(--serif);letter-spacing:-1.8px;margin:12px 0 14px}.section-head p{color:var(--muted);font-size:17px;margin:0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.step{border:1px solid var(--line);border-radius:20px;background:#fff;padding:25px;min-height:220px}.step-num{font:italic 24px var(--serif);color:#819b56}.step h3{font-size:19px;margin:31px 0 8px}.step p{color:var(--muted);margin:0;font-size:14px}.sample{background:#18231e;color:#f5f6ee;border-radius:30px;padding:58px;display:grid;grid-template-columns:.8fr 1.2fr;gap:45px;align-items:center}.sample .kicker{color:var(--green)}.sample h2{max-width:390px}.sample p{color:#b3beb4}.samples{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.sample-card{background:#27332c;border:1px solid #3a493e;border-radius:15px;padding:12px}.thumb{aspect-ratio:9/12;border-radius:9px;background:linear-gradient(150deg,#b4a084,#465c50 60%,#202a24);position:relative;overflow:hidden}.thumb:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,#111c)}.thumb .mini-person{position:absolute;width:48px;height:78px;left:calc(50% - 24px);top:28%;background:#27312c;border-radius:22px 22px 8px 8px}.thumb .mini-person:before{content:"";position:absolute;background:#c09270;width:36px;height:37px;top:-25px;left:6px;border-radius:50%}.thumb-caption{position:absolute;z-index:1;bottom:15px;left:5px;right:5px;text-align:center;font-size:11px;font-weight:900;color:#fff;text-shadow:0 1px 3px #222}.sample-meta{padding:10px 2px 0;font-size:12px;color:#c1cbc0;display:flex;justify-content:space-between}.sample-meta strong{color:white}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.feature{padding:22px;border-radius:17px;background:white;border:1px solid var(--line)}.feature .icon{font-size:22px}.feature h3{font-size:15px;margin:16px 0 6px}.feature p{margin:0;font-size:13px;color:var(--muted)}.pricing{background:#eeefe8}.price-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:800px}.price-card{background:white;border:1px solid var(--line);border-radius:22px;padding:28px}.price-card.featured{background:var(--green);border-color:var(--green)}.plan{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.price{font:48px var(--serif);margin:15px 0 3px}.price small{font:14px system-ui;color:#69746c}.price-desc{font-size:14px;color:#657069;min-height:40px}.price-card ul{list-style:none;padding:0;margin:23px 0;display:grid;gap:12px;font-size:14px}.price-card li:before{content:"✓";font-weight:900;margin-right:9px}.price-card .btn{width:100%;justify-content:center}.faq{max-width:760px}.faq details{border-bottom:1px solid var(--line);padding:18px 0}.faq summary{font-weight:700;cursor:pointer}.faq p{color:var(--muted);font-size:14px}.cta{padding:65px 30px;text-align:center;border-radius:28px;background:var(--green)}.cta h2{max-width:650px;margin:10px auto 15px}.cta p{color:#526047;margin:0 auto 24px}.footer{padding:32px 0;color:#69746c;font-size:13px;display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:80px}.modal{position:fixed;inset:0;background:#131c18a8;z-index:10;display:none;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.dialog{width:min(560px,100%);background:var(--paper);border-radius:22px;padding:28px;box-shadow:0 20px 80px #0004}.dialog-head{display:flex;justify-content:space-between;align-items:center}.dialog h2{font-size:33px}.close{background:none;border:0;font-size:25px}.tabs{display:flex;background:#e9eae3;padding:4px;border-radius:99px;width:max-content;margin:18px 0}.tabs button{border:0;background:transparent;border-radius:99px;padding:8px 15px;font-size:13px}.tabs button.active{background:white;box-shadow:0 1px 5px #0001}.uploadbox{border:1.5px dashed #aab4a9;border-radius:17px;padding:26px;text-align:center;background:white}.uploadbox .upicon{font-size:31px}.uploadbox p{font-size:13px;color:var(--muted)}.uploadbox input{max-width:100%;margin:auto}.urlbox{display:none}.urlbox input{width:100%;border:1px solid var(--line);border-radius:12px;padding:13px;margin:10px 0 15px}.notice{margin-top:15px;padding:12px;background:#eef0e8;border-radius:10px;font-size:12px;color:#59665b}.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);background:#17231f;color:white;padding:13px 18px;border-radius:99px;opacity:0;pointer-events:none;transition:.25s;z-index:15;font-size:13px}.toast.show{opacity:1;transform:translate(-50%,0)}
    @media(max-width:850px){.hero{grid-template-columns:1fr;gap:35px;padding:55px 0}.stage{min-height:390px}.video{height:315px;width:245px}.sample{grid-template-columns:1fr;padding:38px}.feature-grid{grid-template-columns:repeat(2,1fr)}.navlinks{display:none}.trust{align-items:flex-start;flex-direction:column}.trust-items{flex-wrap:wrap;gap:15px}}
    @media(max-width:560px){.wrap{width:calc(100% - 32px)}.nav{height:66px}.navright>a:first-child{display:none}.hero{padding:44px 0}.hero h1{letter-spacing:-2.5px}.lead{font-size:16px}.stage{min-height:340px;padding:14px}.video{height:280px;width:215px}.label-top{top:32px;left:10px}.label-bottom{bottom:22px;right:4px}.trust-items{font-size:12px}.section{padding:70px 0}.steps{grid-template-columns:1fr}.step{min-height:0}.step h3{margin-top:20px}.sample{padding:28px 20px}.samples{gap:7px}.sample-card{padding:7px}.sample-meta{font-size:10px}.feature-grid{grid-template-columns:1fr 1fr}.feature{padding:16px}.price-grid{grid-template-columns:1fr}.footer{flex-direction:column;gap:12px}.cta{padding:45px 20px}}
  </style>
</head>
<body>
  <header class="wrap nav"><a href="#top" class="brand"><span class="logo">✳</span>claircut</a><nav class="navlinks"><a href="#comment">Comment ça marche</a><a href="#qualite">Notre approche</a><a href="#tarifs">Tarifs</a></nav><div class="navright"><a href="#tarifs">Se connecter</a><button class="btn btn-dark" data-open>Essayer gratuitement <span>↗</span></button></div></header>
  <main id="top"><section class="wrap hero"><div><span class="eyebrow"><i class="dot"></i> Le clipping vidéo pensé en français</span><h1>Les bons moments.<br><em>Au bon format.</em></h1><p class="lead">Transforme tes podcasts, interviews et vidéos YouTube en clips verticaux soignés, sous-titrés et prêts à publier.</p><div class="actions"><button class="btn btn-dark" data-open>Créer mes clips <span>↗</span></button><a class="btn btn-light" href="#comment">Voir comment ça marche <span>↓</span></a></div><p class="micro">Aperçus gratuits · Pas de carte bancaire · Tu gardes le contrôle</p></div><div class="stage"><div class="clip-label label-top"><strong>Un moment qui accroche</strong><span>00:42 — 01:18 · 36 s</span></div><div class="video"><div class="person"></div><div class="play">▶</div><div class="sub">Le vrai déclic,<br>c'est quand <b>tu oses.</b></div><div class="bar"></div></div><div class="clip-label label-bottom"><strong>Recadrage intelligent</strong><div class="wave">▂ ▅ ▃ ▇ ▄ ▆ ▂ ▅</div></div></div></section>
  <div class="wrap trust"><strong>Fait pour les vidéos où les idées comptent.</strong><div class="trust-items"><span><i class="tick">✓</i> Podcasts filmés</span><span><i class="tick">✓</i> Interviews</span><span><i class="tick">✓</i> Conseils &amp; tutoriels</span></div></div>
  <section class="wrap section" id="comment"><div class="section-head"><span class="kicker">Simple du début à la fin</span><h2>De ta vidéo à tes prochains posts.</h2><p>Tu choisis les moments. Claircut s’occupe du travail répétitif et te laisse corriger le résultat.</p></div><div class="steps"><article class="step"><span class="step-num">01 / Importer</span><h3>Dépose ta vidéo</h3><p>Envoie un fichier vidéo ou colle un lien YouTube compatible. Le site te dira clairement si la vidéo peut être traitée.</p></article><article class="step"><span class="step-num">02 / Choisir</span><h3>Prévisualise les meilleurs passages</h3><p>Reçois plusieurs propositions avec leur durée et une explication de ce qui rend chaque moment intéressant.</p></article><article class="step"><span class="step-num">03 / Peaufiner</span><h3>Corrige, puis exporte</h3><p>Ajuste les coupes, le cadrage et les sous-titres français. Télécharge tes clips prêts pour les réseaux.</p></article></div></section>
  <section class="wrap sample" id="qualite"><div><span class="kicker">Pas de boîte noire</span><h2>Tu vois pourquoi ce moment a été choisi.</h2><p>Un bon clip commence par un passage qui se comprend tout seul. Claircut met en avant les moments forts, puis te laisse valider avant l’export.</p><a class="btn btn-lime" href="#tarifs">Découvrir les offres <span>↘</span></a></div><div class="samples"><div class="sample-card"><div class="thumb"><div class="mini-person"></div><div class="thumb-caption">C'EST LÀ QUE<br>TOUT CHANGE</div></div><div class="sample-meta"><strong>Le déclic</strong><span>00:36</span></div></div><div class="sample-card"><div class="thumb" style="background:linear-gradient(150deg,#8eaa9b,#b88b70 50%,#263b35)"><div class="mini-person"></div><div class="thumb-caption">ON A SOUVENT<br>PEUR DE ÇA</div></div><div class="sample-meta"><strong>La question</strong><span>00:48</span></div></div><div class="sample-card"><div class="thumb" style="background:linear-gradient(150deg,#d2b998,#69796c 55%,#28342c)"><div class="mini-person"></div><div class="thumb-caption">VOICI CE QUE<br>J'AI COMPRIS</div></div><div class="sample-meta"><strong>La leçon</strong><span>00:29</span></div></div></div></section>
  <section class="wrap section"><div class="section-head"><span class="kicker">À toi de régler le détail</span><h2>Un résultat propre, sans perdre ta voix.</h2><p>Les outils doivent t’aider à publier plus vite, pas à rendre tes vidéos toutes pareilles.</p></div><div class="feature-grid"><article class="feature"><span class="icon">💬</span><h3>Sous-titres français</h3><p>Corrige les mots, les noms propres et la ponctuation facilement.</p></article><article class="feature"><span class="icon">🎨</span><h3>Styles personnalisables</h3><p>Choisis la police, les couleurs et la mise en évidence des mots.</p></article><article class="feature"><span class="icon">🎯</span><h3>Cadrage qui suit l’action</h3><p>Garde la personne à l’image et reprends la main si besoin.</p></article><article class="feature"><span class="icon">✂️</span><h3>Coupes ajustables</h3><p>Règle le début et la fin sans te battre avec un éditeur compliqué.</p></article></div></section>
  <section class="section pricing" id="tarifs"><div class="wrap"><div class="section-head"><span class="kicker">Commence gratuitement</span><h2>Tu vois le résultat avant de t’engager.</h2><p>Les tarifs ci-dessous sont une proposition de départ, à ajuster après les premiers retours et le calcul des coûts vidéo.</p></div><div class="price-grid"><article class="price-card"><span class="plan">Découverte</span><div class="price">0 €</div><p class="price-desc">Pour essayer le rendu sur une première vidéo.</p><ul><li>Analyse d’une vidéo courte</li><li>Aperçu de plusieurs clips</li><li>2 exports avec filigrane</li><li>Sous-titres français</li></ul><button class="btn btn-light" data-open>Tester gratuitement</button></article><article class="price-card featured"><span class="plan">Créateur</span><div class="price">9,90 € <small>/ mois · tarif indicatif</small></div><p class="price-desc">Pour publier régulièrement sans repartir de zéro.</p><ul><li>Vidéos plus longues et plus d’exports</li><li>Téléchargement sans filigrane</li><li>Édition des clips et sous-titres</li><li>Projets conservés pendant l’abonnement</li></ul><button class="btn btn-dark" data-open>Rejoindre la liste de lancement</button></article></div></div></section>
  <section class="wrap section faq"><div class="section-head"><span class="kicker">Questions fréquentes</span><h2>Avant de te lancer.</h2></div><details><summary>Est-ce que je peux coller n’importe quel lien YouTube ?</summary><p>Pas forcément. Certaines vidéos ou plateformes limitent le téléchargement et le traitement. Le prototype prévoit un import de fichier et un lien compatible, avec un message clair si le lien ne fonctionne pas.</p></details><details><summary>Est-ce que l’IA choisit toujours les bons passages ?</summary><p>Non. Elle propose des moments pour te faire gagner du temps, mais tu peux vérifier les aperçus et corriger les coupes avant de télécharger.</p></details><details><summary>À qui appartient la vidéo que j’importe ?</summary><p>Tu dois avoir les droits ou l’autorisation nécessaires pour utiliser la vidéo. Les règles de conservation et de suppression devront être précisées avant le lancement public.</p></details></section>
  <section class="wrap cta"><span class="kicker">Tes idées méritent d’être vues</span><h2>Prêt à donner une seconde vie à tes vidéos ?</h2><p>Teste le parcours et dis-nous ce qui ferait vraiment gagner du temps.</p><button class="btn btn-dark" data-open>Créer mes clips <span>↗</span></button></section></main>
  <footer class="wrap footer"><a class="brand" href="#top"><span class="logo">✳</span>claircut</a><span>Le clipping vidéo pensé en français.</span><span>© 2026 Claircut · Projet en développement</span></footer>
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="dialog"><div class="dialog-head"><div><span class="kicker">Première étape</span><h2 id="modal-title">Ajoute ta vidéo</h2></div><button class="close" aria-label="Fermer">×</button></div><div class="tabs"><button class="active" data-tab="file">Importer un fichier</button><button data-tab="url">Coller un lien</button></div><div class="uploadbox" id="file-pane"><div class="upicon">↑</div><strong>Choisis une vidéo sur ton appareil</strong><p>MP4, MOV ou WebM · Le traitement réel sera disponible au lancement</p><input type="file" accept="video/*" id="video-file"></div><div class="urlbox" id="url-pane"><label for="video-url"><strong>Lien vers une vidéo YouTube</strong></label><input id="video-url" type="url" placeholder="https://www.youtube.com/watch?v=…"><button class="btn btn-dark" id="analyze">Continuer</button></div><div class="notice">Importe uniquement une vidéo que tu as le droit d’utiliser. Cette maquette ne téléverse ni ne traite encore de vidéo.</div></div></div><div class="toast" id="toast"></div>
  <script>
    const modal=document.getElementById('modal'),toast=document.getElementById('toast');
    document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>{modal.classList.add('open');document.body.style.overflow='hidden'}));
    function closeModal(){modal.classList.remove('open');document.body.style.overflow=''}
    document.querySelector('.close').addEventListener('click',closeModal);modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
    document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.getElementById('file-pane').style.display=b.dataset.tab==='file'?'block':'none';document.getElementById('url-pane').style.display=b.dataset.tab==='url'?'block':'none'}));
    function showToast(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3500)}
    document.getElementById('video-file').addEventListener('change',e=>{if(e.target.files.length)showToast('Vidéo choisie. Le traitement sera activé dans la prochaine étape.')});
    document.getElementById('analyze').addEventListener('click',()=>{const v=document.getElementById('video-url').value;if(!v){showToast('Ajoute un lien vidéo pour continuer.');return}showToast('Le traitement vidéo sera connecté dans la prochaine étape.')});
  </script>
</body>
</html>
